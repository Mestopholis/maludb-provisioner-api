# This file intentionally contains no real credentials.
# Exact variables will be defined in Phase 01 after stack selection.

MALUDB_ENV=development
MALUDB_CONTROL_PLANE_DATABASE_URL=
MALUDB_GATEWAY_DOMAIN=maludb.local

# Key management (ADR-023, docs/SECRETS.md).
# The KEK unwraps the data encryption keys in the encryption_keys table. It must
# never be stored in the control-plane database or committed. Backend choice is
# an open question; a file is acceptable for development only.
MALUDB_SECRET_STORE=
MALUDB_KEK_REF=

# Server-side pepper for hashing high-entropy tokens (API keys, PATs, sessions).
# Held outside the database so a database-only compromise yields no offline-
# verifiable hashes.
MALUDB_TOKEN_PEPPER_REF=
