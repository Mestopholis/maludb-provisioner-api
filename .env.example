# This file intentionally contains no real credentials.
# Exact variables will be defined in Phase 01 after stack selection.

MALUDB_ENV=development
MALUDB_CONTROL_PLANE_DATABASE_URL=
MALUDB_GATEWAY_DOMAIN=maludb.local

# Key management (ADR-023, docs/SECRETS.md).
# The KEK unwraps the data encryption keys in the encryption_keys table. It must
# never be stored in the control-plane database or committed. Backend choice is
# an open question; a file is acceptable for development only.
MALUDB_SECRET_STORE=
MALUDB_KEK_REF=

# Server-side pepper for hashing high-entropy tokens (API keys, PATs, sessions).
# Held outside the database so a database-only compromise yields no offline-
# verifiable hashes.
MALUDB_TOKEN_PEPPER_REF=

# Realtime (ADR-033, ADR-034, ADR-035). Where a Realtime container reaches this
# node's PostgreSQL: a private address on an interface of its own, never
# loopback. The container is given no route to the node's loopback on purpose --
# with one it reaches every other worker on the node, including other tenants'
# PostgREST. A worker refuses to start without this.
MALUDB_REALTIME_DB_HOST=
MALUDB_REALTIME_DB_PORT=5432
# Pinned by ADR-033: latest dies with SIGILL in a precompiled NIF on a CPU with
# no AVX, which these nodes are.
MALUDB_REALTIME_IMAGE=docker.io/supabase/realtime:v2.110.0
MALUDB_REALTIME_MEMORY_MAX=512m
