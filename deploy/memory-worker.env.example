# /etc/maludb/memory-worker.env
#
# Read by maludb-memory-worker.service. chmod 600, owned by maludb-memory.
# Deliberately not control-plane.env: this process has no business with node
# superuser credentials or Stripe keys, so it is not handed the file that has them.

MALUDB_ENV=production

# The worker's OWN role (slice 5c), a member of cp_memory_worker -- never the control
# plane's. It refuses to start in production as anything wider (docs/DEPLOYMENT.md 1.6).
MALUDB_CONTROL_PLANE_DATABASE_URL=postgresql://memworker:CHANGEME@127.0.0.1:5432/maludb_control_plane

# The KEK: the worker opens each project's sealed memory writer password and each
# project's provider API keys (slice 5b). Mode 0600, as for every other process that holds it.
MALUDB_KEK_REF=/etc/maludb/keys/kek
MALUDB_TOKEN_PEPPER_REF=/etc/maludb/keys/pepper

# The port tenant databases answer on at each node's internal_host.
MALUDB_MEMORY_DB_PORT=5432

# Slice 5b: every provider call leaves through maludb-egress-proxy. Required in
# production -- the worker refuses to start without it rather than try a direct
# connection its unit would drop anyway.
MALUDB_MEMORY_EGRESS_PROXY=http://127.0.0.1:3128
