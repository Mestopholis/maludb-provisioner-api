# /etc/maludb/node-reporter.env  -- on the NODE. Mode 0600, owned by root.
#
# The reporter's OWN control-plane role (ADR-080): it can execute
# public.report_node_health(bigint) and nothing else. Never the control plane's
# role or the gateway's -- `cp-manage node reporter grant` refuses both.
MALUDB_NODE_REPORTER_DATABASE_URL=postgresql://reporter_node01:CHANGEME@10.0.0.10:5432/maludb_control_plane?sslmode=require

# Optional. Free disk is measured here; placement compares it with the node's
# min_free_disk_bytes (20 GiB unless set at registration).
#MALUDB_NODE_DATA_DIRECTORY=/var/lib/postgresql
# Optional. The cluster that must answer before a report is sent. No credential:
# libpq's ping asks whether the server accepts connections, not whether we may.
#MALUDB_NODE_LOCAL_POSTGRES=host=127.0.0.1 port=5432 dbname=postgres connect_timeout=5
# Optional, 5..90 seconds.
#MALUDB_NODE_REPORT_INTERVAL_SECONDS=60
