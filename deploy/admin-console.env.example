# /etc/maludb/admin-console.env
#
# Read by maludb-control-plane-admin.service only (ADR-082). chmod 600, owned by root:
# it carries the console's database password.
#
# There is no MALUDB_KEK_REF and no MALUDB_TOKEN_PEPPER_REF here, and there must not
# be: the console holds the staff key and nothing else.

MALUDB_ENV=production

# The console's own database role, narrowed to what the reports read (slice 2).
# Never the control plane's DSN from control-plane.env.
MALUDB_ADMIN_DATABASE_URL=postgresql://cp_admin:CHANGEME@127.0.0.1:5432/maludb_control_plane

# Where the console listens. A private address on the operator network.
#
# Not 0.0.0.0, and not a public address: preflight refuses both. Staff reach it over the
# VPN; verify from outside the operator network that it does not answer.
MALUDB_ADMIN_BIND=10.0.0.10

# The session cookie's Secure flag. Leave it on. Turn it off only where the listener is
# plain HTTP inside the VPN, because a browser will not send a Secure cookie over HTTP.
# MALUDB_ADMIN_COOKIE_SECURE=false

# The staff key arrives as the systemd credential `staff-key` (LoadCredential in the
# unit). Outside systemd, point at the file instead; mode 600, and never the KEK's material.
# MALUDB_STAFF_KEY_REF=/etc/maludb/keys/staff-key
