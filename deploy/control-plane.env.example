# /etc/maludb/control-plane.env
#
# Read by maludb-control-plane-public.service,
# maludb-control-plane-internal.service and maludb-provisioner.service.
# chmod 600: it carries a database password.

MALUDB_ENV=production

MALUDB_CONTROL_PLANE_DATABASE_URL=postgresql://cp:CHANGEME@127.0.0.1:5432/maludb_control_plane

# Key material. Both files must be mode 0600 -- the loader refuses anything
# group- or world-readable. Losing the KEK is terminal: ADR-070 makes the
# control plane refuse to start rather than mint a replacement, because a
# database full of ciphertext and a fresh key is worse than a failure to boot.
MALUDB_KEK_REF=/etc/maludb/keys/kek
MALUDB_TOKEN_PEPPER_REF=/etc/maludb/keys/pepper

# Where the INTERNAL listener binds (ADR-037). A private address.
#
# Not 0.0.0.0, and not a public address. This application mounts every router
# including /internal/hooks/email/{ref}, whose only other protection is its own
# signature. Verify from outside the host after deploying; a bind address is not
# a firewall, and a reverse proxy or a permissive security group can undo it.
MALUDB_INTERNAL_BIND=10.0.0.10

# The hostname is the routing key (ADR-008), and project API URLs are derived
# from this. It defaults to maludb.local, which routes nothing -- so leaving it
# unset ships customers URLs that cannot resolve.
MALUDB_GATEWAY_DOMAIN=example.com

# Where password-reset links point.
MALUDB_DASHBOARD_URL=https://example.com

# Cloudflare Turnstile. captcha_required defaults to ON when MALUDB_ENV is
# production, and verification fails CLOSED when the challenge service cannot be
# reached -- an outage stops signups rather than admitting unverified accounts.
# The site key that pairs with this goes in frontend/index.html.
MALUDB_CAPTCHA_SECRET=CHANGEME

# Billing is inert until both are set. Nothing else maps a plan to a price:
#   cp-manage billing price set --plan starter --price price_...
# and `cp-manage maintenance run` is what applies a purchase (ADR-053).
#MALUDB_STRIPE_SECRET_KEY=sk_live_CHANGEME
#MALUDB_STRIPE_WEBHOOK_SECRET=whsec_CHANGEME

# The node role that owns tenant databases. The provisioner refuses to start
# without it; on a MaluDB node that is `postgres`.
MALUDB_PLATFORM_OWNER=postgres
