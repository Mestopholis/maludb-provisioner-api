# /etc/maludb/memory-embedder.env
#
# Read by maludb-memory-embedder.service. chmod 600, owned by maludb-embedder.
# Its own file: not the worker's, which carries a role that opens memory writer
# passwords, and not control-plane.env.

MALUDB_ENV=production

# A LOGIN role in cp_memory_embedder -- never the control plane's own. The embedder
# refuses to start in production as anything wider (docs/DEPLOYMENT.md 1.6).
MALUDB_CONTROL_PLANE_DATABASE_URL=postgresql://memembed:CHANGEME@127.0.0.1:5432/maludb_control_plane

# The KEK opens provider keys; the pepper verifies customers' secret keys.
MALUDB_KEK_REF=/etc/maludb/keys/kek
MALUDB_TOKEN_PEPPER_REF=/etc/maludb/keys/pepper

MALUDB_MEMORY_EGRESS_PROXY=http://127.0.0.1:3128

# The private address the nodes' gateways reach. Each gateway's gateway.env sets
# MALUDB_MEMORY_EMBEDDER_URL=http://<this address>:<port>.
MALUDB_MEMORY_EMBEDDER_BIND=10.0.0.2:8114
