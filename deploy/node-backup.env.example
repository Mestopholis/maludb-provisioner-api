# /etc/maludb/node-backup.env -- read by maludb-node-backup@.service (as root, by systemd).
# chmod 600. Carries the backup recorder's password; nothing else here is secret.

# The node's backup recorder role (ADR-086), created on the control plane and mapped with
# `cp-manage node backup-recorder grant`. It may call three functions for this node.
MALUDB_BACKUP_RECORDER_DATABASE_URL=postgresql://backup_node01:CHANGEME@10.0.0.10:5432/maludb_control_plane?sslmode=require

# The stanza in /etc/pgbackrest.conf, and the one `cp-manage node backup-check --stanza` recorded.
MALUDB_BACKUP_STANZA=maludb-node-01

# Optional: pgBackRest processes for a backup (1..16). Its cores come out of the node's tenants.
#MALUDB_BACKUP_PROCESS_MAX=2
