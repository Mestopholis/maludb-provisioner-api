# /etc/maludb/gateway.env  -- on the NODE, not the control plane.
#
# Separate from control-plane.env on purpose: this file must carry the narrowed
# database URL, and sharing a file with the control plane's own would make it
# one edit away from carrying the wide one instead.

MALUDB_ENV=production

# ADR-072. The gateway's OWN role, which cannot read nodes.admin_ciphertext.
#
# Create and grant it from the control-plane host:
#     sudo -u postgres psql -d maludb_control_plane -c "CREATE ROLE gw LOGIN PASSWORD '...'"
#     cp-manage gateway grant --role gw --node <node>
#
# Pointing this at the control plane's own DSN gives a gateway that works
# perfectly and can recover every node's superuser DSN. A production gateway
# refuses to start when that is true -- the check asks the database what this
# role can read, not whether this variable is set.
MALUDB_GATEWAY_DATABASE_URL=postgresql://gw:CHANGEME@10.0.0.10:5432/maludb_control_plane?sslmode=require

# Still required: the gateway reads the control plane's schema through the role
# above, and holds the KEK to decrypt per-project credentials it starts workers
# with. Same key material as the control plane, same 0600 requirement.
MALUDB_CONTROL_PLANE_DATABASE_URL=postgresql://gw:CHANGEME@10.0.0.10:5432/maludb_control_plane?sslmode=require
MALUDB_KEK_REF=/etc/maludb/keys/kek
MALUDB_TOKEN_PEPPER_REF=/etc/maludb/keys/pepper

MALUDB_GATEWAY_DOMAIN=example.com

# Set only if this node runs Realtime or Storage workers; both address
# PostgreSQL and the object store on a data address rather than loopback,
# because a rootless container cannot reach the node's loopback (ADR-035).
#MALUDB_REALTIME_DB_HOST=10.90.0.1
#MALUDB_STORAGE_DB_HOST=10.91.0.1
# Storage is served only when this is set (docs/DEPLOYMENT.md §2.7). The gateway
# never uses the S3 credential; it registers projects with the worker.
#MALUDB_STORAGE_S3_ENDPOINT=http://10.0.0.20:8333
