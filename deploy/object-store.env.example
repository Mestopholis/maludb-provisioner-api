# /etc/maludb/object-store/object-store.env -- read by maludb-object-store.service.
# Addresses only; the credential is in s3.json beside it.

# The dummy interface's address (deploy/10-maludb-data.network). The master,
# volume server and filer listen here and nowhere else.
MALUDB_OBJECT_STORE_DATA_ADDRESS=10.91.0.1

# This node's private address. The S3 gateway listens here, so the control plane
# can reach it; the firewall admits only the control plane.
MALUDB_OBJECT_STORE_S3_ADDRESS=10.0.0.20
